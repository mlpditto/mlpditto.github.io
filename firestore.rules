rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    // Check if user is the admin (by email or role).
    // Uses .get('role', '') so a user doc without a 'role' field returns false
    // cleanly instead of throwing "Property role is undefined".
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'medlifeplus@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
      );
    }

    // Defensive .get() defaults so a missing 'access' map or ungranted area
    // resolves to false instead of throwing.
    function hasAreaAccess(area) {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('access', {}).get(area, false) == true;
    }

    // Check if user is the owner of the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // A non-admin creating their own user doc must not seed privileged fields
    // (role / access / a non-pending status) — those are granted by admins only.
    function safeSelfUserCreate() {
      return !('role' in request.resource.data)
          && !('access' in request.resource.data)
          && (!('status' in request.resource.data) || request.resource.data.status == 'pending');
    }

    // A non-admin editing their own user doc may change profile fields, but must
    // not add or alter role / access / status (prevents self privilege-escalation).
    function safeSelfUserUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['role', 'access', 'status']);
    }

    // --- Collection Rules ---

    // FAQs: Public Read, Admin Write
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users: Owner can read/edit their own profile, Admin can do all.
    // role / access / status stay admin-only so users cannot self-escalate.
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if isAdmin() || (isOwner(userId) && safeSelfUserCreate());
      allow update: if isAdmin() || (isOwner(userId) && safeSelfUserUpdate());
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Tasks: Admin full access. Users can read/write their own tasks.
    match /tasks/{taskId} {
      allow read: if isAdmin() || (isAuthenticated() && (resource.data.createdBy == request.auth.uid || resource.data.userId == request.auth.uid));
      allow create: if isAuthenticated();
      // createdAt is immutable on edit (no client path rewrites it; blocks backdating).
      allow update: if (isAdmin() || (isAuthenticated() && (resource.data.createdBy == request.auth.uid || resource.data.userId == request.auth.uid)))
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt']);
      allow delete: if isAdmin() || (isAuthenticated() && (resource.data.createdBy == request.auth.uid || resource.data.userId == request.auth.uid));
    }

    // Archive: Admin only
    match /archive/{archiveId} {
      allow read, write: if isAdmin();
    }
    
    // Shared Stock / System / Settings: Public read for app functionality, Admin write
    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /master_products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // CKNC medicine-name -> master_products mapping (สร้างจากหน้ากระทบยอดบิล CKNC).
    // alias ใช้ร่วมกัน: staff ที่ล็อกอินเพิ่ม/แก้ได้, ลบได้เฉพาะ admin. ไม่แตะ master_products.
    match /cknc_medicine_aliases/{aliasId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ทะเบียนเจ้า (supplier) — doc id = โค้ดเจ้า, aliasKeys = ชื่อดิบไว้ map ชื่อจาก ProOrder/LINE MAN.
    // สิทธิ์แนวเดียวกับ cknc_medicine_aliases: staff ที่ล็อกอินเพิ่ม/แก้เจ้าใหม่ได้ระหว่างทำงาน, ลบได้เฉพาะ admin.
    match /suppliers/{supplierId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // VCI System Rules (Visitor Check-in)
    match /companies/{companyId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /visitor_registrations/{regId} {
      allow create: if true; 
      allow read: if isAdmin() || isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    match /visitor_logs/{logId} {
      allow create: if true;
      allow read: if isAdmin() || isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /visitor_appointments/{aptId} {
      allow create: if true;
      allow read: if isAdmin() || isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    // System Test
    match /system_test/{docId} {
      allow read, write: if isAdmin();
    }

    // Sales Analytics: admin or users granted the 'analytics' area
    match /sales_analytics/{docId} {
      allow read, write: if isAdmin() || hasAreaAccess('analytics');
    }

    // Sales Analytics: customer name merge aliases (heuristic dedup, v7) — สิทธิ์เดียวกับ sales_analytics
    match /sales_analytics_customer_aliases/{aliasId} {
      allow read, write: if isAdmin() || hasAreaAccess('analytics');
    }

    // TMTP Manager: admin or users granted the 'tmtp' area
    match /tmtp_records/{docId} {
      allow read, write: if isAdmin() || hasAreaAccess('tmtp');
    }

    // Append-only backup log: authorized tmtp users may add a snapshot,
    // but reading/altering/deleting backups is admin-only.
    match /tmtp_backups/{docId} {
      allow create: if isAdmin() || hasAreaAccess('tmtp');
      allow read, update, delete: if isAdmin();
    }

    // LINE MAN Sales Backups (auto-backup snapshots)
    match /lineman_backups/{docId} {
      allow read, write: if isAdmin();
    }

    // CKNC reconciliation saved sessions
    match /cknc_sessions/{sessionId} {
      allow read, write: if isAdmin() || hasAreaAccess('cknc');
    }

    // CKNC reconciliation monthly autosaves
    match /cknc_monthly_autosaves/{monthId} {
      allow read, write: if isAdmin() || hasAreaAccess('cknc');
    }

    // ECOM Access Codes
    match /ecom_access_codes/{codeId} {
      allow read: if true; 
      allow write: if isAdmin();
    }
  }
}
